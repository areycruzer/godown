# LLM — pick one provider (all use OpenAI-compatible chat + tools)
# glm | openai | gemini | custom
LLM_PROVIDER=glm

# Generic (optional). If set, overrides the provider-specific key/model/url below.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- GLM / Zhipu (LLM_PROVIDER=glm) ---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5-flash

# --- OpenAI (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# defaults: base https://api.openai.com/v1 , model gpt-4o-mini

# --- Gemini (LLM_PROVIDER=gemini) — Google OpenAI-compat endpoint ---
GEMINI_API_KEY=
# defaults: base https://generativelanguage.googleapis.com/v1beta/openai/
#           model gemini-2.0-flash

# --- custom: set LLM_API_KEY + LLM_MODEL + LLM_BASE_URL ---

# IndiaMART egress — empty PROXY if already on Indian ISP
PROXY_URL=
REQUIRE_INDIA_EGRESS=true

# Optional login: sessions/ak.txt + cookie_header.txt, or IM_* below
SESSIONS_DIR=
IM_AK=
IM_COOKIE=
USE_AK=false

MAX_CONCURRENCY=8
REQUEST_TIMEOUT_S=45
USER_AGENT=Godown-IndiaMART-Agent/1.0
